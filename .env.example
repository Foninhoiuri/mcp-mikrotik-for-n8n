# ── Conexão MikroTik ──────────────────────────────────────────
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USERNAME=admin
MIKROTIK_PASSWORD=changeme
MIKROTIK_PORT=22

# ── Transporte MCP ────────────────────────────────────────────
MIKROTIK_MCP__TRANSPORT=sse
MIKROTIK_MCP__HOST=0.0.0.0
MIKROTIK_MCP__PORT=8000
MIKROTIK_MCP__ALLOWED_HOSTS=*

# ── Logging ───────────────────────────────────────────────────
# Níveis: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Rede Docker ───────────────────────────────────────────────
# Nome da rede Docker onde o n8n está rodando (para os containers se comunicarem)
N8N_NETWORK_NAME=n8n_default
